{# Access groups / direct users from the Netbox teleport_groups and teleport_allowed_users
   custom fields (comma-separated, flattened hostvars). Rendered as numbered labels
   (group/group_2/..., allowed_user/allowed_user_2/...) because Teleport label
   expressions cannot split() values. #}
{% set teleport_group_list = ((teleport_groups | default('', true)) or '').split(',') | map('trim') | select | list %}
{% set teleport_allowed_user_list = ((teleport_allowed_users | default('', true)) or '').split(',') | map('trim') | select | list %}
version: v3
teleport:
  nodename: {{ ansible_facts['hostname'] }}
  data_dir: /var/lib/teleport
  join_params:
    token_name: {{ teleport_agent_token }}
    method: token
  proxy_server: {{ teleport_cluster }}:443
  log:
    output: stderr
    severity: WARNING
    format:
      output: text
  diag_addr: ""
auth_service:
  enabled: "no"
ssh_service:
  enabled: "yes"
  pam:
    enabled: "yes"
    service_name: "sshd"
  labels:
    role: {{ device_roles[0] }}
    tenant: {{ tenants[0] }}
    site: {{ sites[0] }}
{% for group in teleport_group_list %}
    group{{ '' if loop.first else '_' ~ loop.index }}: {{ group }}
{% endfor %}
{% for user in teleport_allowed_user_list %}
    allowed_user{{ '' if loop.first else '_' ~ loop.index }}: {{ user }}
{% endfor %}
  commands:
  - name: hostname
    command: [hostname]
    period: 1m0s
{% if teleport_agent_enhanced_recording_enabled %}
  enhanced_recording:
    enabled: true
    command_buffer_size: {{ teleport_agent_enhanced_recording_command_buffer_size }}
    network_buffer_size: {{ teleport_agent_enhanced_recording_network_buffer_size }}
{% endif %}
proxy_service:
  enabled: "no"
  https_keypairs: []
  https_keypairs_reload_interval: 0s
  acme: {}
app_service:
  enabled: "{{ 'yes' if (teleport_agent_apps | length > 0) or (services | selectattr('custom_fields.expose_mode', 'defined') | selectattr('custom_fields.expose_mode', 'equalto', 'teleport') | list | length > 0) else 'no' }}"
  apps:
{% for app in teleport_agent_apps %}
  -  name: "{{ app.name }}"
     uri: "{{ app.url }}"
     public_addr: "{{ app.name }}.teleport.ethquokkaops.io"
     labels:
       tenant: {{ tenants[0] }}
{% for group in teleport_group_list %}
       group{{ '' if loop.first else '_' ~ loop.index }}: {{ group }}
{% endfor %}
{% for user in teleport_allowed_user_list %}
       allowed_user{{ '' if loop.first else '_' ~ loop.index }}: {{ user }}
{% endfor %}
{% endfor %}
{% for svc in services if svc.custom_fields.expose_mode == "teleport" %}
  -  name: "{{ svc.custom_fields.teleport_name }}"
     uri: "http://127.0.0.1:{{ svc.ports[0] }}"
     public_addr: "{{ svc.custom_fields.teleport_name }}.teleport.ethquokkaops.io"
     labels:
       tenant: {{ tenants[0] }}
{% for group in teleport_group_list %}
       group{{ '' if loop.first else '_' ~ loop.index }}: {{ group }}
{% endfor %}
{% for user in teleport_allowed_user_list %}
       allowed_user{{ '' if loop.first else '_' ~ loop.index }}: {{ user }}
{% endfor %}
{% endfor %}

{% if (teleport_agent_desktops | length > 0) %}
windows_desktop_service:
  enabled: true
  static_hosts:
{% for desktop in teleport_agent_desktops %}
  - name: "{{ desktop.name }}"
    ad: false
    addr: "{{ desktop.ip }}"
    labels:
      tenant: "{{ desktop.tenant }}"
      project: "{{ desktop.project }}"

{% endfor %}
{% endif %}
