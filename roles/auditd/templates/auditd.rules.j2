##
## Audit rules managed by Ansible (ethdevops.infrastructure role auditd).
## Do not edit by hand - change the role variables instead.
##
## Only watches on paths that exist on this host are rendered: a watch on a
## missing path makes auditd refuse to load the ruleset.
{% if auditd_loginuid_immutable %}

## Once set, a process's loginuid (auid) cannot be changed, not even by
## root, so events stay attributable to the user who logged in.
--loginuid-immutable
{% endif %}

## /etc and its high-signal files (dedicated keys so the central alerts can
## tell them apart from the bulk /etc watch)
{% for watch in auditd_watches_existing %}
-w {{ watch.path }} -p {{ watch.perm }} -k {{ watch.key }}
{% endfor %}

## SSH key material (root plus every real user account that has a .ssh dir)
{% for dir in auditd_ssh_key_dirs_existing %}
-w {{ dir }} -p wa -k sshkeys
{% endfor %}

## Network: binds. The kernel emits a SOCKADDR record for every bind; the
## vector transform decodes the AF_INET/AF_INET6 ones into
## bind_addr/bind_port. The socket family sits behind the a1 pointer, not
## in a filterable syscall argument, so the rule filters on addrlen (a2)
## instead: AF_INET/AF_INET6 binds need at least 16 bytes (EINVAL below),
## which drops AF_NETLINK (12 bytes, getifaddrs() polling) and short AF_UNIX
## paths. Remaining AF_UNIX binds have no laddr/lport, so they get no
## bind_addr and cannot trip the wildcard-listen alerts.
##
## Every syscall rule has a b32 twin: 64-bit rules do not see syscalls made
## through the 32-bit ABI. Twins sit right after their b64 rule so that a
## rejected line drops the following keys and trips the role's key check.
##
## wazuh-syscheckd binds a 16-byte socket on every FIM event: ~800k
## SYSCALL+PROCTITLE lines/h fleet-wide (46% of the audit tier, Oct 2026).
## First match wins, so the never rule must precede the nbind rule.
-a never,exit -F arch=b64 -S bind -F exe=/var/ossec/bin/wazuh-syscheckd
-a always,exit -F arch=b64 -S bind -F a2>=16 -k nbind
-a always,exit -F arch=b32 -S bind -F a2>=16 -k nbind

## Account management tooling
{% for exe in ['/usr/sbin/useradd', '/usr/sbin/usermod', '/usr/sbin/groupadd', '/usr/sbin/groupmod', '/usr/sbin/chpasswd', '/usr/bin/passwd'] %}
-a always,exit -F arch=b64 -S execve -F exe={{ exe }} -k acctmgmt
-a always,exit -F arch=b32 -S execve -F exe={{ exe }} -k acctmgmt
{% endfor %}

## Kernel module loading (rootkit / eBPF signal)
-a always,exit -F arch=b64 -S init_module -S finit_module -k modload
-a always,exit -F arch=b32 -S init_module -S finit_module -k modload

## Process tracing / injection (devs use gdb and strace, so the central
## alert for this is warning-level)
-a always,exit -F arch=b64 -S ptrace -k ptrace
-a always,exit -F arch=b32 -S ptrace -k ptrace

## Clock tampering. adjtimex is left out on purpose: node_exporter, chrony
## and do-agent call it constantly to read the clock, and reads cannot be
## told apart from writes in-kernel (the mode sits behind a pointer).
-a always,exit -F arch=b64 -S clock_settime -S settimeofday -k time
-a always,exit -F arch=b32 -S clock_settime -S settimeofday -k time

{% if auditd_immutable %}
## Lock the ruleset in the kernel. From here on any change requires a
## reboot; the role relies on that and will not restart auditd when the
## rules change.
-e 2
{% endif %}
